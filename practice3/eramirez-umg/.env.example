# Copy to .env and set a shared JWT key of at least 32 bytes.
# For an existing installation, reuse its backend Jwt:Key to keep tokens valid.
JWT_KEY=
JWT_ISSUER=EnterpriseApi
JWT_AUDIENCE=EnterpriseApp

# Optional: change host ports when other practices are running.
FRONTEND_PORT=81
BACKEND_PORT=5000
CATALOG_PORT=8080
CART_PORT=3000
MYSQL_PORT=3307
MONGO_PORT=27017
